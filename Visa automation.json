    {
      "parameters": {
        "jsCode": "// Normalize Twilio WhatsApp payload (robust for n8n Webhook output)\n\nconst payload = $json.body ?? $json;\n\nconst from = payload.From || payload.from || '';\n\n// Remove whatsapp: and leading +\nconst user_phone = from\n  .replace(/^whatsapp:/, '')\n  .replace(/^\\+/, '');\n\nconst user_name = payload.ProfileName || payload.profileName || 'Unknown';\nconst text = payload.Body || payload.body || '';\n\nconst numMedia = parseInt(payload.NumMedia ?? payload.numMedia ?? '0', 10) || 0;\nconst media_urls = [];\n\nfor (let i = 0; i < numMedia; i++) {\n  const url = payload[`MediaUrl${i}`];\n  if (url) media_urls.push(url);\n}\n\nif (media_urls.length === 0 && payload.MediaUrl0) {\n  media_urls.push(payload.MediaUrl0);\n}\n\nreturn {\n  user_phone,\n  user_name,\n  text,\n  media_urls,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
